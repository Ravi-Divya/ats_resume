# Copy this file to `.env.local` for local development.
# For production (Render), set these in the Environment section of your service.

# Groq API key (server-side only - NEVER expose this to the browser).
# Get one free at https://console.groq.com
GROQ_API_KEY=

# Optional: override the default AI model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
